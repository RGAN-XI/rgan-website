+  publishedAt: z.coerce
+    .date({
+      errorMap: () => ({ message: "Select a published month and year" }),
+    })
+    .transform(
+      (value) => new Date(Date.UTC(value.getUTCFullYear(), value.getUTCMonth(), 1)),
+    ),
   isCurrent: z.boolean().optional().default(false),
